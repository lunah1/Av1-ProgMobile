<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp">

    <ImageView
        android:id="@+id/img_estabelecimento"
        android:layout_width="90dp"
        android:layout_height="90dp"
        android:scaleType="centerCrop"
        android:contentDescription="Imagem do estabelecimento" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/txt_nome_estabelecimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nome do estabelecimento"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txt_endereco_estabelecimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Endereço"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/txt_horario_estabelecimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Horário"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/txt_descricao_estabelecimento"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descrição"
            android:layout_marginTop="4dp" />

    </LinearLayout>

</LinearLayout>